"""importa a biblioteca pandas para usar com o csv"""
import pandas as pd
data = pd.read_csv('data.csv', sep=';')
df_docs = pd.DataFrame(data)

def nao_elegivel():
    """Função que retorna um dataframe com os clientes
    que tem inconsistencia na entrega de documentos"""

    filtro = (df_docs['PossuiGravacao'] == 'NAO') | (df_docs['PossuiFoto'] == 'NAO')

# filtro  <-  armazena a condição dentro de uma variavel
# ()  <-  oque esta dentro se torna uma condição,
# |  <-  equivalente ao "OR" do python    

    filtrado = df_docs.loc[filtro, ['Cliente', 'NumeroProposta', 'PossuiGravacao']].to_string()
    return filtrado

#df_docs.loc <- peço para o dataframe selecionar e indexar as colunas que eu escolher
#[filtro, [colunas]] <- o "filtro" é a condição que eu criei, o dataframe ver as linhas que atendem a condição
#[filtro, [colunas]] <- o "colunas" são as colunas que vai ter no dataframe e vão passar pela condição

dado_filtrado = nao_elegivel()
print (dado_filtrado)
