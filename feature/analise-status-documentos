"""importa a biblioteca pandas para usar com o csv"""
import pandas as pd
data = pd.read_csv('data.csv', sep=';')
df_docs = pd.DataFrame(data)

def sem_gravacao():
    """Função que retorna um dataframe com os clientes
    que não tem gravação com o documento"""

    filtro = (df_docs['PossuiGravacao'] == 'NAO')
# filtro  <-  armazena a condição dentro de uma variavel
# ()  <-  oque esta dentro se torna uma condição,
# |  <-  equivalente ao "OR" do python    

    filtrado = df_docs.loc[filtro, ['Cliente', 'NumeroProposta', 'PossuiGravacao']].to_string()
    return filtrado

#df_docs.loc <- peço para o dataframe selecionar e indexar as colunas que eu escolher
#[filtro, [colunas]] <- o "filtro" é a condição que eu criei, o dataframe ver as linhas que atendem a condição
#[filtro, [colunas]] <- o "colunas" são as colunas que vai ter no dataframe e vão passar pela condição

def sem_documento():
    """Função que retorna um dataframe com os clientes
    que tem qualquer um dos documentos em falta"""

    filtro = ((df_docs['PossuiGravacao'] == 'NAO') |
             (df_docs['PossuiFoto'] == 'NAO'))
#
    filtrado = df_docs.loc[filtro, ['Cliente', 'NumeroProposta', 'PossuiGravacao', 'PossuiFoto']]
    filtrado = filtrado.to_string()
    return filtrado

def contrato_elegivel():
    """Função que retorna em um dataframe todos os clientes
    que não estão em falta com entrega de documentos"""

    filtro = (df_docs['PossuiGravacao'] == 'SIM') | (df_docs['PossuiFoto'] == 'SIM')
#
    filtrado = df_docs[filtro, ['Clientes', 'NumeroProposta', 'PossuiGravacao', 'PossuiFoto']]
#
    filtrado = filtrado.to_string()
    return filtrado

print(sem_documento())
print(sem_gravacao())
print(contrato_elegivel())
